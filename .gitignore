.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

reports/
captures/

.DS_Store
*.log

# Real/sensitive capture files should never be committed. Small synthetic
# fixtures generated by tests or examples/generate_sample_pcap.py are the
# only .pcap/.pcapng files this repo intentionally tracks.
*.pcap
*.pcapng
*.cap
!examples/sample_capture.pcap
!tests/fixtures/*.pcap
